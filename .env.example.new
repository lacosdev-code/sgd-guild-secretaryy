# Environment Variables — SGD Guild Secretary (Post-Migration)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://sgd_user:GANTI_PASSWORD_INI@localhost:5432/sgd_db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="GANTI_DENGAN_RANDOM_STRING_32_CHARS_MINIMAL"
NEXTAUTH_URL="https://secretary.sgd-corp.com"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://secretary.sgd-corp.com"

# ── File Storage (Local VPS) ──────────────────────────────────────────────────
# Path di dalam container Docker (mount volume ke VPS)
UPLOAD_DIR="/data/uploads"

# ── Web Push Notifications ────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="VAPID_PUBLIC_KEY_KAMU"
VAPID_PRIVATE_KEY="VAPID_PRIVATE_KEY_KAMU"
VAPID_SUBJECT="mailto:admin@sgd-corp.com"

# ── Internal API (untuk n8n / webhook) ────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_API_SECRET="GANTI_DENGAN_SECRET_RANDOM"
